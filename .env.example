# ==========================================
# TRALIX AI V2 Configuration
# ==========================================

# ---------- Database (Postgres - required for production) ----------
# Neon free tier, Render Postgres, Supabase, or any hosted Postgres URL.
# If omitted during local development/tests, an in-memory database is used automatically.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session secret for signing cookies
SESSION_SECRET=change-this-to-a-secure-random-32-char-string-in-production

# ---------- Text LLM (NVIDIA NIM or any OpenAI-compatible provider) ----------
# NVIDIA NIM free tier at https://build.nvidia.com:
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-YOUR_NVIDIA_API_KEY
LLM_MODEL=meta/llama-3.3-70b-instruct
# Optional utility model (defaults to LLM_MODEL)
LLM_TITLE_MODEL=meta/llama-3.3-70b-instruct
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TOOLS=true
LLM_REQUIRE_KEY=true

# ---------- Vision Model (NVIDIA Multimodal VLM) ----------
# Live NVIDIA multimodal vision model for photo & video frame understanding
VISION_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_API_KEY=nvapi-YOUR_NVIDIA_API_KEY
VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# ---------- Image Generation (NVIDIA NIM FLUX.1 or OpenAI) ----------
# Provider: nvidia | openai
IMAGE_PROVIDER=nvidia
IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
IMAGE_API_KEY=nvapi-YOUR_NVIDIA_API_KEY
IMAGE_MODEL=black-forest-labs/flux.1-schnell
IMAGE_DAILY_LIMIT_PER_USER=10

# ---------- Object Storage (Cloudflare R2 or S3-compatible) ----------
# Optional: if omitted, uploads are stored locally in UPLOAD_DIR
# Cloudflare R2 endpoint format: https://<account_id>.r2.cloudflarestorage.com
# STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_r2_access_key_id
# STORAGE_SECRET_KEY=your_r2_secret_access_key
# STORAGE_BUCKET=tralix-media
# STORAGE_REGION=auto
# UPLOAD_DIR=/data/uploads

# ---------- Real-time Web Search (optional) ----------
# Provide ONE of the following:
# TAVILY_API_KEY=tvly-YOUR_KEY
# BRAVE_API_KEY=
# SEARXNG_URL=
# SEARCH_PROVIDER=tavily
# SEARCH_MAX_RESULTS=6

# Weather via Open-Meteo (no key needed)
ENABLE_WEATHER=true

# ---------- Server Configuration ----------
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=true
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_API_PER_MIN=240
RATE_LIMIT_AUTH_PER_MIN=10
