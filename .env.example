# ---------- Text model (required) ----------
# Any OpenAI-compatible Chat Completions endpoint.
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:      http://localhost:11434/v1   (set LLM_REQUIRE_KEY=false)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: cheaper/faster model for conversation titles (defaults to LLM_MODEL)
# LLM_TITLE_MODEL=
# LLM_TEMPERATURE=0.7
# LLM_MAX_OUTPUT_TOKENS=2048
# Set to false if your model does not support tool/function calling (disables live search + weather)
# LLM_TOOLS=true
# LLM_REQUIRE_KEY=true

# ---------- Real-time web search (recommended) ----------
# Provide ONE of the following. SEARCH_PROVIDER is auto-detected from whichever is set.
# TAVILY_API_KEY=       # https://tavily.com
# BRAVE_API_KEY=        # https://brave.com/search/api
# SEARXNG_URL=          # self-hosted SearXNG with the json format enabled
# SEARCH_PROVIDER=tavily|brave|searxng|none
# SEARCH_MAX_RESULTS=6

# Weather via Open-Meteo (no key needed)
# ENABLE_WEATHER=true

# ---------- Server ----------
# PORT=8787
# HOST=0.0.0.0
# DATABASE_PATH=./data/tralix.db
# TRUST_PROXY=true
# RATE_LIMIT_CHAT_PER_MIN=20
